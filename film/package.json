{
  "name": "@exlipse/film",
  "private": true,
  "version": "1.0.0",
  "description": "The Exlipse film, rendered from code: WebGL2 scenes, adaptive typography and a synthesized score.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "render": "node --experimental-strip-types tools/render.ts",
    "score": "python audio/synth.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
